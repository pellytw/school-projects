<%= form_with(model: school, class: "form") do |form| %>
  <% if school.errors.any? %>
    <div class="error-box">
      <h2>No se pudo guardar la escuela</h2>
      <ul>
        <% school.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "Nombre" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :code, "Codigo" %>
    <%= form.text_field :code %>
  </div>

  <div class="field">
    <%= form.label :address, "Direccion" %>
    <%= form.text_field :address %>
  </div>

  <div class="field">
    <%= form.label :level, "Nivel" %>
    <%= form.select :level, School::LEVELS.map { |value, label| [label, value] }, prompt: "Seleccionar nivel" %>
  </div>

  <div class="field">
    <%= form.label :locality_id, "Localidad" %>
    <%= form.collection_select :locality_id, @localities, :id, :display_name, prompt: "Seleccionar localidad" %>
  </div>

  <div class="actions">
    <%= form.submit class: "button primary" %>
  </div>
<% end %>
