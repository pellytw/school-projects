<% content_for :title, "Escuelas" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Instituciones</p>
    <h1>Escuelas</h1>
  </div>

  <%= link_to "Nueva escuela", new_school_path, class: "button primary" %>
</section>

<div class="list">
  <% @schools.each do |school| %>
    <%= link_to school_path(school), class: "list-row" do %>
      <span>
        <strong><%= school.name %></strong>
        <small><%= School::LEVELS.fetch(school.level.to_sym) %> - <%= school.locality.display_name %></small>
      </span>
      <span class="badge"><%= pluralize(school.projects.count, "proyecto") %></span>
    <% end %>
  <% end %>
</div>
