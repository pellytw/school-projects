<div id="<%= dom_id school %>">
  <p>
    <strong>Name:</strong>
    <%= school.name %>
  </p>

  <p>
    <strong>Code:</strong>
    <%= school.code %>
  </p>

  <p>
    <strong>Address:</strong>
    <%= school.address %>
  </p>

  <p>
    <strong>Level:</strong>
    <%= school.level %>
  </p>

  <p>
    <strong>Locality:</strong>
    <%= school.locality_id %>
  </p>

</div>
