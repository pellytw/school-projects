<div id="<%= dom_id project %>">
  <p>
    <strong>Title:</strong>
    <%= project.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= project.description %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= project.category %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= project.status %>
  </p>

  <p>
    <strong>Starts on:</strong>
    <%= project.starts_on %>
  </p>

  <p>
    <strong>Ends on:</strong>
    <%= project.ends_on %>
  </p>

  <p>
    <strong>School:</strong>
    <%= project.school_id %>
  </p>

</div>
